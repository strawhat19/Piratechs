{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "rootDir": "src/scripts",
    "outDir": "scripts",
    "strict": true,
    "sourceMap": false,
    "declaration": false,
    "moduleResolution": "Bundler",
    "noEmitOnError": true,
    "skipLibCheck": true
  },
  "include": [
    "src/scripts/**/*.ts"
  ]
}
